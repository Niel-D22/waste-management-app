# Dipakai OTOMATIS oleh "npm run build" (Vite membaca .env.production saat
# mode produksi). Berkas .env biasa hanya berlaku untuk "npm run dev".
#
# ┌─ WAJIB DIGANTI SEBELUM BUILD UNTUK NETLIFY ─────────────────────────────┐
# │ Ganti baris di bawah dengan alamat server backend Anda yang bisa        │
# │ dijangkau dari internet, lengkap dengan /api di ujungnya.               │
# │                                                                        │
# │   contoh:  VITE_API_URL=https://api.torangbersih.my.id/api             │
# │   contoh:  VITE_API_URL=https://abc123.ngrok-free.app/api              │
# │                                                                        │
# │ Nilai ini DIPANGGANG ke dalam berkas hasil build. Mengubahnya setelah   │
# │ build tidak ada efeknya — harus build ulang.                           │
# │                                                                        │
# │ Alamat localhost SENGAJA ditolak saat build produksi (lihat            │
# │ vite.config.js). Situs yang menunjuk ke localhost akan terlihat hidup   │
# │ di komputer Anda tapi mati total di komputer juri.                     │
# └────────────────────────────────────────────────────────────────────────┘
VITE_API_URL=GANTI_DENGAN_URL_SERVER_ANDA/api

# Client ID Google OAuth. Domain Netlify Anda harus didaftarkan lebih dulu di
# Google Cloud Console > Credentials > Authorized JavaScript origins, kalau
# tidak tombol "Masuk dengan Google" akan ditolak dengan error redirect_uri.
VITE_GOOGLE_CLIENT_ID=808674051703-3rp9vgcuj874ciouhtmiocq627eu36r5.apps.googleusercontent.com
